{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "dev:cloud": "wrangler pages dev dist --port 8788",
    "cf:migrate:local": "wrangler d1 migrations apply true-or-dare-catalog-local --local",
    "cf:deploy:backup": "wrangler deploy --config backup-worker/wrangler.jsonc",
    "catalog:materialize": "tsx scripts/materialize_catalog.ts",
    "clean": "node -e \"for (const p of ['dist','server.js']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/wardrobe.test.ts src/utils/cardSelection.test.ts src/utils/cardTimer.test.ts src/utils/progression.test.ts src/utils/playerStorage.test.ts src/utils/cardImageStore.test.ts src/utils/cardSchema.test.ts src/data/cardIcons.test.ts src/data/localCatalog.test.ts functions/_shared/catalog.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "fflate": "^0.8.3",
    "jose": "^6.2.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.124.0"
  }
}
